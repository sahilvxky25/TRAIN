<mujoco model="balance_bot">
  <option timestep="0.002" integrator="implicitfast"/>
  <visual><global offwidth="640" offheight="480"/></visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".25 .3 .35" rgb2=".18 .22 .27"
             width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid"
          friction="1 0.005 0.0001"/>
    <site name="target" pos="0 0 0.01" size="0.06 0.06 0.004" type="cylinder"
          rgba="0.1 0.9 0.2 0.6"/>
    <body name="chassis" pos="0 0 0.08">
      <freejoint name="root"/>
      <geom name="body" type="box" size="0.04 0.09 0.12" pos="0 0 0.14" mass="1.5"
            rgba="0.2 0.5 0.9 1"/>
      <geom name="head" type="sphere" size="0.03" pos="0 0 0.28" mass="0.05"
            rgba="0.9 0.3 0.2 1"/>
      <geom name="nose" type="box" size="0.01 0.04 0.02" pos="0.05 0 0.2" mass="0.001"
            rgba="1 1 0 1"/>
      <body name="wheel_l" pos="0 0.12 0">
        <joint name="wl" type="hinge" axis="0 1 0" damping="0.002"/>
        <geom name="wl_geom" type="cylinder" size="0.08 0.015" euler="90 0 0" mass="0.15"
              friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="wheel_r" pos="0 -0.12 0">
        <joint name="wr" type="hinge" axis="0 1 0" damping="0.002"/>
        <geom name="wr_geom" type="cylinder" size="0.08 0.015" euler="90 0 0" mass="0.15"
              friction="1 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="motor_l" joint="wl" gear="0.6" ctrlrange="-1 1"/>
    <motor name="motor_r" joint="wr" gear="0.6" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
